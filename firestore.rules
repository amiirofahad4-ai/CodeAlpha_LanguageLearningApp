rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Course content: any signed-in user can read, nobody can write from the app.
    match /languages/{doc=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Each user can only read and write their own profile and progress.
    match /users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
